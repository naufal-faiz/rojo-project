{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/components/form/CheckboxComponents.tsx",
    "src/components/form/DefaultInputs.tsx",
    "src/components/form/DropZone.tsx",
    "src/components/form/FileInputExample.tsx",
    "src/components/form/InputGroup.tsx",
    "src/components/form/InputStates.tsx",
    "src/components/form/RadioButtons.tsx",
    "src/components/form/SelectInputs.tsx",
    "src/components/form/TextAreaInput.tsx",
    "src/components/form/ToggleSwitch.tsx",
    "src/components/form/date-picker.tsx",
    "src/components/form/form-elements/**",
    "src/components/main/perusahaan/**",
    "src/components/main/peserta/**",
    "src/components/main/training/**",
    "src/components/main/permohonan/PelaksanaanList.tsx",
    "src/components/main/permohonan/PelaksanaanFormModal.tsx",
    "src/components/main/permohonan/SesiManager.tsx",
    "src/components/main/permohonan/StatusTemanK3Cell.tsx",
    "src/components/main/permohonan/statusTemanK3.ts",
    "src/lib/data/action/perusahaanAction.ts",
    "src/lib/data/action/pesertaAction.ts",
    "src/lib/data/action/trainingAction.ts",
    "src/lib/data/action/pelaksanaanAction.ts",
    "src/lib/data/get/getPerusahaan.ts",
    "src/lib/data/get/getPeserta.ts",
    "src/lib/data/get/getTraining.ts",
    "src/lib/data/get/getPelaksanaan.ts"
  ]
}
