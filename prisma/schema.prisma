// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipeCabang {
  HQ // alamat/kantor pusat perusahaan itu sendiri
  CABANG
  DEPOT
}

enum TipePic {
  INTERNAL // karyawan/HSE perusahaan klien
  DINAS // pihak dinas pemerintah
  MITRA // staf PJK3 mitra
}

enum TipePelaksanaan {
  ONLINE
  OFFLINE
  BLENDED
}

enum JenisKegiatan {
  PUBLIK // peserta dari banyak perusahaan dan/atau mandiri
  INHOUSE // diselenggarakan khusus untuk satu perusahaan klien
}

enum JenisSertifikasi {
  KEMNAKER
  BNSP
  INTERNAL // di luar sertifikat resmi (mis. food handler)
}

// Enum butuh migration kalau ada penyelenggara baru (keputusan: dibiarkan enum dulu).
enum Penyelenggara {
  WINA_KARYA_MULIA // Rojo Safety sendiri
  DELTA_INDONESIA
  LIMA_PRIMA_SOLUSINDO // PJK3 LPS
  ARTA_KARYA_AREFAA
}

// Status administratif permohonan ke TemanK3 (level pelaksanaan)
enum StatusTemanK3 {
  BELUM_UPLOAD
  SUDAH_UPLOAD
  FU_LPS
  CANCEL
}

// Status hasil peserta per pelaksanaan
enum StatusPeserta {
  LULUS
  GAGAL
  REMEDIAL
  IKUT_BATCH_SELANJUTNYA
  TAKEOUT
  CANCEL
}

// ---------------------------------------------------------
// MASTER TRAINING
// ---------------------------------------------------------

model Training {
  id   String @id @default(uuid()) @db.Uuid
  nama String

  tingkatan Tingkatan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("training")
}

model Tingkatan {
  id         String   @id @default(uuid()) @db.Uuid
  trainingId String   @map("training_id") @db.Uuid
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Restrict)

  kelas String // contoh: "Kelas 1", "Damkar C"

  pelaksanaan Pelaksanaan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([trainingId])
  @@map("tingkatan")
}

// ---------------------------------------------------------
// PERUSAHAAN & CABANG
// ---------------------------------------------------------

model Perusahaan {
  id          String  @id @default(uuid()) @db.Uuid
  nama        String
  alamatLegal String? @map("alamat_legal")

  cabang        Cabang[]
  perusahaanPic PerusahaanPic[]
  pendaftaran   PendaftaranPerusahaan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("perusahaan")
}

// Setiap perusahaan wajib punya minimal 1 Cabang bertipe HQ.
model Cabang {
  id           String     @id @default(uuid()) @db.Uuid
  perusahaanId String     @map("perusahaan_id") @db.Uuid
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)

  nama   String
  tipe   TipeCabang
  alamat String?

  peserta Peserta[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([perusahaanId])
  @@map("cabang")
}

model Peserta {
  id                 String @id @default(uuid()) @db.Uuid
  nama               String
  // Nullable: peserta yang belum bekerja / tidak terdaftar di perusahaan (UI tampil "-").
  perusahaanCabangId String? @map("perusahaan_cabang_id") @db.Uuid
  cabang             Cabang? @relation(fields: [perusahaanCabangId], references: [id], onDelete: Restrict)

  pesertaPelaksanaan PesertaPelaksanaan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([perusahaanCabangId])
  @@map("peserta")
}

// ---------------------------------------------------------
// PIC
// ---------------------------------------------------------

model Pic {
  id     String  @id @default(uuid()) @db.Uuid
  nama   String
  noTelp String? @map("no_telp")
  tipe   TipePic

  perusahaanPic PerusahaanPic[]
  pendaftaran   PendaftaranPerusahaan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("pic")
}

// Tabel penghubung (many-to-many). Sengaja hard delete: hanya relasi,
// riwayat PIC per kegiatan tetap tersimpan di PendaftaranPerusahaan.picId.
model PerusahaanPic {
  id           String     @id @default(uuid()) @db.Uuid
  perusahaanId String     @map("perusahaan_id") @db.Uuid
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)
  picId        String     @map("pic_id") @db.Uuid
  pic          Pic        @relation(fields: [picId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([perusahaanId, picId])
  @@index([picId])
  @@map("perusahaan_pic")
}

// ---------------------------------------------------------
// PELAKSANAAN
// ---------------------------------------------------------

model Pelaksanaan {
  id String @id @default(uuid()) @db.Uuid

  // Nullable (kasus DELTA/LPS: Rojo tidak pegang nomornya).
  // @unique di Postgres mengizinkan banyak NULL, jadi aman.
  noPermohonan String? @unique @map("no_permohonan")

  tingkatanId String    @map("tingkatan_id") @db.Uuid
  tingkatan   Tingkatan @relation(fields: [tingkatanId], references: [id], onDelete: Restrict)

  jenisKegiatan    JenisKegiatan    @map("jenis_kegiatan")
  tipePelaksanaan  TipePelaksanaan  @map("tipe_pelaksanaan")
  lokasi           String?
  penyelenggara    Penyelenggara
  jenisSertifikasi JenisSertifikasi @map("jenis_sertifikasi")

  status     StatusTemanK3 @default(BELUM_UPLOAD)
  uploadedAt DateTime?     @map("uploaded_at")

  catatan String?

  sesi               SesiPelaksanaan[]
  pendaftaran        PendaftaranPerusahaan[]
  pesertaPelaksanaan PesertaPelaksanaan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tingkatanId])
  @@map("pelaksanaan")
}

// Satu baris per hari aktual. Hard delete (ikut parent, tidak berdiri sendiri).
model SesiPelaksanaan {
  id            String      @id @default(uuid()) @db.Uuid
  pelaksanaanId String      @map("pelaksanaan_id") @db.Uuid
  pelaksanaan   Pelaksanaan @relation(fields: [pelaksanaanId], references: [id], onDelete: Restrict)
  tanggal       DateTime    @db.Date

  @@index([pelaksanaanId])
  @@map("sesi_pelaksanaan")
}

// ---------------------------------------------------------
// PENDAFTARAN PERUSAHAAN (batch per perusahaan per pelaksanaan)
// ---------------------------------------------------------

model PendaftaranPerusahaan {
  id            String      @id @default(uuid()) @db.Uuid
  perusahaanId  String      @map("perusahaan_id") @db.Uuid
  perusahaan    Perusahaan  @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)
  pelaksanaanId String      @map("pelaksanaan_id") @db.Uuid
  pelaksanaan   Pelaksanaan @relation(fields: [pelaksanaanId], references: [id], onDelete: Restrict)
  picId         String      @map("pic_id") @db.Uuid
  pic           Pic         @relation(fields: [picId], references: [id], onDelete: Restrict)

  pesertaPelaksanaan PesertaPelaksanaan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Setelah soft delete, baris lama tetap memegang constraint ini:
  // pendaftaran ulang = RESTORE baris lama, bukan membuat baris baru.
  @@unique([perusahaanId, pelaksanaanId])
  // Target FK komposit dari PesertaPelaksanaan (menjaga konsistensi pelaksanaanId).
  @@unique([id, pelaksanaanId])
  @@index([pelaksanaanId])
  @@index([picId])
  @@map("pendaftaran_perusahaan")
}

// ---------------------------------------------------------
// PESERTA_PELAKSANAAN (pendaftaran + hasil sertifikasi)
// ---------------------------------------------------------

model PesertaPelaksanaan {
  id            String      @id @default(uuid()) @db.Uuid
  pesertaId     String      @map("peserta_id") @db.Uuid
  peserta       Peserta     @relation(fields: [pesertaId], references: [id], onDelete: Restrict)
  pelaksanaanId String      @map("pelaksanaan_id") @db.Uuid
  pelaksanaan   Pelaksanaan @relation(fields: [pelaksanaanId], references: [id], onDelete: Restrict)

  // null = peserta mandiri; terisi = didaftarkan perusahaan.
  // FK komposit (pendaftaranPerusahaanId, pelaksanaanId): jika pendaftaranPerusahaanId
  // terisi, DB memastikan pelaksanaanId sama dengan milik pendaftaran tsb. Jika null
  // (mandiri), Postgres melewati pengecekan (MATCH SIMPLE).
  // onDelete: Restrict eksplisit agar tidak berubah diam-diam jadi "mandiri" (SetNull).
  pendaftaranPerusahaanId String?                @map("pendaftaran_perusahaan_id") @db.Uuid
  pendaftaranPerusahaan   PendaftaranPerusahaan? @relation(fields: [pendaftaranPerusahaanId, pelaksanaanId], references: [id, pelaksanaanId], onDelete: Restrict)

  status                  StatusPeserta?
  noRegistrasi            String?        @map("no_registrasi")
  noSertifikat            String?        @map("no_sertifikat")
  masaBerlaku             DateTime?      @map("masa_berlaku") @db.Date
  noSkp                   String?        @map("no_skp") // hanya relevan untuk KEMNAKER, disembunyikan di UI selain itu
  tanggalTerimaSertifikat DateTime?      @map("tanggal_terima_sertifikat") @db.Date

  catatan String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Mencegah peserta yang sama terdaftar dua kali di satu pelaksanaan,
  // baik lewat perusahaan maupun mandiri (karena itu pelaksanaanId tetap disimpan langsung).
  @@unique([pesertaId, pelaksanaanId])
  @@index([pelaksanaanId])
  @@index([pendaftaranPerusahaanId])
  @@map("peserta_pelaksanaan")
}
