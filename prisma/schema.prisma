// SKEMA BARU (draft). Ganti nama jadi schema.prisma saat siap migrasi.
// Dihapus dari skema lama: Pic, PerusahaanPic, PendaftaranPerusahaan, StatusTemanK3, TipePic, uploadedAt.
generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipeCabang {
  HQ
  CABANG
  DEPOT
}

enum TipePelaksanaan {
  ONLINE
  OFFLINE
  BLENDED
}

enum JenisKegiatan {
  PUBLIK
  INHOUSE
}

enum JenisSertifikasi {
  KEMNAKER
  BNSP
  INTERNAL
}

enum Penyelenggara {
  WINA_KARYA_MULIA
  DELTA_INDONESIA
  LIMA_PRIMA_SOLUSINDO
  ARTA_KARYA_AREFAA
  LIK
  ITC
}

enum JenisKelamin {
  L
  P
}

// Disimpan hanya yang tidak bisa dihitung dari tanggal sesi.
// Belum mulai / berjalan / selesai dihitung dari SesiPelaksanaan.
enum StatusPelaksanaan {
  AKTIF
  DITUNDA
  DIBATALKAN
}

// Alur pendaftaran: DRAFT -> SIAP -> (DIKEMBALIKAN -> SIAP) -> DIPAKAI
enum StatusPendaftaran {
  DRAFT
  SIAP
  DIKEMBALIKAN
  DIPAKAI
}

// Hasil peserta setelah pelatihan
enum StatusHasil {
  LULUS
  GAGAL
  REMEDIAL
  IKUT_BATCH_SELANJUTNYA
  TAKEOUT
  CANCEL
}

enum JenisDokumen {
  KTP
  IJAZAH
  PAS_FOTO
  SURAT_KERJA
  PAKTA_INTEGRITAS
  SERTIFIKAT
}

model Training {
  id        String    @id @default(uuid()) @db.Uuid
  nama      String
  kelas     Kelas[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("training")
}

// Sebelumnya Tingkatan.
model Kelas {
  id          String        @id @default(uuid()) @db.Uuid
  trainingId  String        @map("training_id") @db.Uuid
  training    Training      @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  nama        String // contoh: "Kelas 1", "Damkar C"
  pelaksanaan Pelaksanaan[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  @@index([trainingId])
  @@map("kelas")
}

// Tanpa UI master. Dibuat/dicari inline dari form pendaftaran.
model Perusahaan {
  id        String    @id @default(uuid()) @db.Uuid
  nama      String
  cabang    Cabang[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("perusahaan")
}

// Setiap perusahaan punya 1 Cabang bertipe HQ (default, labelnya tidak ditampilkan).
// Depot/cabang tampil sebagai "PT A - Banjar".
model Cabang {
  id           String               @id @default(uuid()) @db.Uuid
  perusahaanId String               @map("perusahaan_id") @db.Uuid
  perusahaan   Perusahaan           @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)
  nama         String // HQ: nama perusahaan; depot: "Banjar"
  tipe         TipeCabang
  alamat       String?
  peserta      Peserta[]
  pendaftaran  PesertaPelaksanaan[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  @@index([perusahaanId])
  @@map("cabang")
}

// Master peserta. Kunci identitas = NIK.
model Peserta {
  id           String               @id @default(uuid()) @db.Uuid
  nik          String               @unique
  nama         String
  tempatLahir  String               @map("tempat_lahir")
  tanggalLahir DateTime             @map("tanggal_lahir") @db.Date
  jenisKelamin JenisKelamin         @map("jenis_kelamin")
  alamat       String?
  noHp         String?              @map("no_hp")
  email        String?
  pendidikan   String?
  jabatan      String?
  cabangId     String?              @map("cabang_id") @db.Uuid // perusahaan terbaru
  cabang       Cabang?              @relation(fields: [cabangId], references: [id], onDelete: Restrict)
  dokumen      Dokumen[] // KTP, ijazah, pas foto, surat kerja (dipakai ulang)
  pendaftaran  PesertaPelaksanaan[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  @@index([cabangId])
  @@map("peserta")
}

// Satu tabel untuk semua file. Bucket privat; yang disimpan hanya path (UUID, tanpa NIK/nama).
// KTP/IJAZAH/PAS_FOTO/SURAT_KERJA -> pesertaId. PAKTA_INTEGRITAS/SERTIFIKAT -> pendaftaranId.
model Dokumen {
  id             String              @id @default(uuid()) @db.Uuid
  jenis          JenisDokumen
  pesertaId      String?             @map("peserta_id") @db.Uuid
  peserta        Peserta?            @relation(fields: [pesertaId], references: [id], onDelete: Restrict)
  pendaftaranId  String?             @map("pendaftaran_id") @db.Uuid
  pendaftaran    PesertaPelaksanaan? @relation(fields: [pendaftaranId], references: [id], onDelete: Restrict)
  path           String
  namaFile       String              @map("nama_file")
  mime           String
  ukuran         Int
  // Pengganti yang belum dikonfirmasi. File lama baru dihapus dari bucket setelah konfirmasi.
  pending        Boolean             @default(false)
  menggantikanId String?             @map("menggantikan_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  deletedAt      DateTime?           @map("deleted_at")

  @@index([pesertaId])
  @@index([pendaftaranId])
  @@map("dokumen")
}

// Permohonan. Dibuat Aurel, pesertanya dipilih dari antrean.
model Pelaksanaan {
  id               String               @id @default(uuid()) @db.Uuid
  noPermohonan     String?              @unique @map("no_permohonan")
  kelasId          String               @map("kelas_id") @db.Uuid
  kelas            Kelas                @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  jenisKegiatan    JenisKegiatan        @map("jenis_kegiatan")
  tipePelaksanaan  TipePelaksanaan      @map("tipe_pelaksanaan")
  lokasi           String?
  penyelenggara    Penyelenggara        @default(WINA_KARYA_MULIA)
  jenisSertifikasi JenisSertifikasi     @map("jenis_sertifikasi")
  status           StatusPelaksanaan    @default(AKTIF)
  catatan          String?
  sesi             SesiPelaksanaan[]
  peserta          PesertaPelaksanaan[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  @@index([kelasId])
  @@map("pelaksanaan")
}

model SesiPelaksanaan {
  id            String      @id @default(uuid()) @db.Uuid
  pelaksanaanId String      @map("pelaksanaan_id") @db.Uuid
  pelaksanaan   Pelaksanaan @relation(fields: [pelaksanaanId], references: [id], onDelete: Restrict)
  tanggal       DateTime    @db.Date

  @@index([pelaksanaanId])
  @@map("sesi_pelaksanaan")
}

// Pendaftaran peserta. pelaksanaanId kosong = masih di antrean (tidak ada tabel antrean terpisah).
// Satu pendaftaran hanya untuk satu permohonan; jika permohonan batal, kembali ke antrean.
// Tambahkan lewat SQL migration (Prisma tidak mendukung partial unique):
//   CREATE UNIQUE INDEX uq_antrean_aktif ON peserta_pelaksanaan (peserta_id)
//   WHERE pelaksanaan_id IS NULL AND deleted_at IS NULL;
model PesertaPelaksanaan {
  id                      String            @id @default(uuid()) @db.Uuid
  pesertaId               String            @map("peserta_id") @db.Uuid
  peserta                 Peserta           @relation(fields: [pesertaId], references: [id], onDelete: Restrict)
  pelaksanaanId           String?           @map("pelaksanaan_id") @db.Uuid
  pelaksanaan             Pelaksanaan?      @relation(fields: [pelaksanaanId], references: [id], onDelete: Restrict)
  // Perusahaan saat mendaftar (riwayat tetap benar jika peserta pindah kerja).
  cabangId                String?           @map("cabang_id") @db.Uuid
  cabang                  Cabang?           @relation(fields: [cabangId], references: [id], onDelete: Restrict)
  statusPendaftaran       StatusPendaftaran @default(DRAFT) @map("status_pendaftaran")
  catatanKembali          String?           @map("catatan_kembali")
  hasil                   StatusHasil?
  noRegistrasi            String?           @map("no_registrasi")
  noSertifikat            String?           @map("no_sertifikat")
  masaBerlaku             DateTime?         @map("masa_berlaku") @db.Date
  noSkp                   String?           @map("no_skp") // hanya KEMNAKER
  tanggalTerimaSertifikat DateTime?         @map("tanggal_terima_sertifikat") @db.Date
  catatan                 String?
  dokumen                 Dokumen[] // pakta integritas + scan sertifikat
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  deletedAt               DateTime?         @map("deleted_at")

  @@unique([pesertaId, pelaksanaanId])
  @@index([pelaksanaanId])
  @@index([statusPendaftaran])
  @@map("peserta_pelaksanaan")
}
